# RFSoC4x2 EDF (Yocto) build configuration.
#
# Sourced by sdbuild/scripts/build_edf_boot.sh. Names the Yocto machine and
# selects the build mode.
#
# EDF_MODE=custom -> generate a machine from a board XSA with sdtgen +
# gen-machine-conf. RFSoC4x2 has no AMD prebuilt machine, and its full base
# overlay XSA carries PL soft MicroBlazes that gen-machine-conf cannot use, so
# the SDT is generated from a minimal PS-only XSA instead (BSP_XSA_PATH).

EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=rfsoc4x2
EDF_LINUX_MACHINE=rfsoc4x2
# board_dts intentionally unset: RFSoC4x2 is not a Xilinx eval board, and every
# board-specific node (gem1 PHY, RF clock chips, INA220s, USB/DP PHYs, CMA) is
# provided by edf_bsp/board.dtsi. 
EDF_BOARD_DTS=
BSP_XSA_PATH=bsp/bsp.xsa
# The ZynqMP SDT always gives the architectural maximum DDR map (8 GB). RFSoC4x2
# has 4 GB of PS DDR (2 GB low bank + 2 GB high bank at 0x8_00000000), so trim the
# high memory bank's reg to 2 GB.
EDF_DDR_HIGH_BANK_REG="0x8 0x0 0x0 0x80000000"
