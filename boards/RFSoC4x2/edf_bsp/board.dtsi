/* RFSoC4x2 board-specific device-tree nodes (appended to the SDT base dts):
 * RGMII PHY on gem1, PS-GTR DP/USB reference clocks, the LMK04828 + dual LMX2594
 * RF clock chips on spi0, a spidev on spi1, and the INA220 power monitors on
 * i2c0. 
 * PHY type cells are numeric (PHY_TYPE_USB3=4, PHY_TYPE_DP=6) because the SDT
 * base dts is pre-flattened and carries no dt-bindings include path. */

/ {
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x20000000>;
			alignment = <0x0 0x2000>;
			/* Pin the cma pool to the low 2 GB DDR bank */
			alloc-ranges = <0x0 0x0 0x0 0x80000000>;
			linux,cma-default;
		};
	};

	dp_clk: psgtr_dp_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <27000000>;
	};

	usb_clk: psgtr_usb_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <26000000>;
	};
};

&gem1 {
	status = "okay";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	phy0: phy@f {
		reg = <0xf>;
		ti,rx-internal-delay = <0x8>;
		ti,tx-internal-delay = <0xa>;
		ti,fifo-depth = <0x1>;
		ti,dp83867-rxctrl-strap-quirk;
	};
};

&sdhci0 {
	no-1-8-v;
};

&psgtr {
	clocks = <&usb_clk>, <&dp_clk>;
	clock-names = "ref0", "ref1";
};

&zynqmp_dpsub {
	phys = <&psgtr 1 6 0 1>, <&psgtr 0 6 1 1>;
};

&usb0 {
	status = "okay";
	phy-names = "usb3-phy";
	phys = <&psgtr 2 4 0 0>;
};

&dwc3_0 {
	status = "okay";
	dr_mode = "peripheral";
	snps,usb3_lpm_capable;
	maximum-speed = "super-speed";
};

&usb1 {
	status = "okay";
	phy-names = "usb3-phy";
	phys = <&psgtr 3 4 1 0>;
};

&dwc3_1 {
	status = "okay";
	dr_mode = "host";
	snps,usb3_lpm_capable;
	maximum-speed = "super-speed";
};

&spi1 {
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <500000>;
	};
};

&spi0 {
	lmk@0 {
		compatible = "ti,lmk04828";
		reg = <0x0>;
		spi-max-frequency = <500000>;
		num_bytes = <3>;
	};
	lmxdac@1 {
		compatible = "ti,lmx2594";
		reg = <0x1>;
		spi-max-frequency = <500000>;
		num_bytes = <3>;
	};
	lmxadc@2 {
		compatible = "ti,lmx2594";
		reg = <0x2>;
		spi-max-frequency = <500000>;
		num_bytes = <3>;
	};
};

&i2c0 {
	ina220_IC77@40 {
		compatible = "ti,ina220";
		reg = <0x40>;
		shunt-resistor = <1000>;
	};
	ina220_IC78@41 {
		compatible = "ti,ina220";
		reg = <0x41>;
		shunt-resistor = <1000>;
	};
	ina220_IC79@42 {
		compatible = "ti,ina220";
		reg = <0x42>;
		shunt-resistor = <1000>;
	};
	ina220_IC80@43 {
		compatible = "ti,ina220";
		reg = <0x43>;
		shunt-resistor = <10000>;
	};
	ina220_IC81@44 {
		compatible = "ti,ina220";
		reg = <0x44>;
		shunt-resistor = <10000>;
	};
	ina220_IC82@45 {
		compatible = "ti,ina220";
		reg = <0x45>;
		shunt-resistor = <10000>;
	};
	ina220_IC83@46 {
		compatible = "ti,ina220";
		reg = <0x46>;
		shunt-resistor = <10000>;
	};
	ina220_IC84@47 {
		compatible = "ti,ina220";
		reg = <0x47>;
		shunt-resistor = <10000>;
	};
	ina220_IC85@48 {
		compatible = "ti,ina220";
		reg = <0x48>;
		shunt-resistor = <10000>;
	};
};
