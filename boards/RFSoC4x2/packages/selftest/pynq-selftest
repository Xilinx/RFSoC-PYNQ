# RX lane alignment (stat_rx_status bit 1) must come up before a DMA round-trip;
# without a gate the recv DMA can block forever when no frames arrive.
CMAC_ALIGN_TIMEOUT_S = 8
CMAC_DMA_TIMEOUT_S = 5


def _cmac_loopback(internal):
    base = _overlay()
    import numpy as np
    from pynq import allocate
    try:
        cmac = base.cmac
        dma = base.dma
    except AttributeError:
        raise Skip("cmac / dma not in overlay")
    cmac.internal_loopback = 1 if internal else 0
    if not internal:
        log.debug("resetting GTs to relock after switching to external loopback")
        cmac.reset(gt=1)
        time.sleep(1)
    log.debug("bringing up CMAC RX/TX and waiting for lane alignment")
    cmac.register_map.conf_rx = 1
    cmac.register_map.conf_tx = 0x10
    deadline = time.time() + CMAC_ALIGN_TIMEOUT_S
    aligned = False
    while time.time() < deadline:
        if cmac.register_map.stat_rx_status[1]:
            aligned = True
            break
        time.sleep(0.1)
    if not aligned:
        if internal:
            raise AssertionError("CMAC RX never aligned in internal loopback "
                                 "(core/reference-clock problem)")
        raise Skip("CMAC RX not aligned -- attach a QSFP loopback module for the "
                   "external-loopback test")
    cmac.register_map.conf_tx = 1
    payload = np.frombuffer(
        (b"PYNQ RFSoC4x2 CMAC 100G loopback self-test frame. " * 8)[:256],
        dtype=np.uint8)
    tx = allocate(payload.shape[0], dtype=np.uint8)
    rx = allocate(payload.shape[0], dtype=np.uint8)
    tx[:] = payload
    try:
        log.debug("DMA send %d bytes + arm recv (timeout %ds)",
                  payload.shape[0], CMAC_DMA_TIMEOUT_S)
        dma.recvchannel.transfer(rx)
        dma.sendchannel.transfer(tx)
        dma.sendchannel.wait(timeout=CMAC_DMA_TIMEOUT_S)
        dma.recvchannel.wait(timeout=CMAC_DMA_TIMEOUT_S)
        if not np.array_equal(tx, rx):
            raise AssertionError("CMAC loopback payload mismatch")
    finally:
        del tx, rx


def b_cmac_internal():
    _cmac_loopback(internal=True)
    ok("CMAC 100G internal-loopback DMA round-trip matched")


def b_cmac_external():
    _cmac_loopback(internal=False)
    ok("CMAC 100G external-loopback DMA round-trip matched (QSFP loopback module)")


# RF clocks live on spi0 (spidev0.0/0.1/0.2); the OLED on spi1 (spidev1.0). The
# PS SPI reference clock must not be the 1 MHz misconfig that made spi1 transfers
# time out -- the real value is 20 MHz.
SPI_DEVS = ("/dev/spidev0.0", "/dev/spidev0.1", "/dev/spidev0.2", "/dev/spidev1.0")
SPI_REF_MIN_HZ = 10000000


def b_spi():
    missing = [d for d in SPI_DEVS if not os.path.exists(d)]
    ok("spidev nodes present (%s)" % ", ".join(os.path.basename(d) for d in SPI_DEVS)) if not missing \
        else bad("missing spidev nodes: %s" % ", ".join(missing))
    summary = read_priv("/sys/kernel/debug/clk/clk_summary")
    if not summary:
        raise Skip("clk_summary not readable (need root) -- cannot verify SPI ref clocks")
    for ref in ("spi0_ref", "spi1_ref"):
        rate = 0
        for line in summary.splitlines():
            toks = line.split()
            if ref in toks:
                try:
                    rate = int(toks[toks.index(ref) + 4])
                except (IndexError, ValueError):
                    rate = 0
                break
        if rate == 0:
            bad("%s not found/parseable in clk_summary" % ref)
        elif rate >= SPI_REF_MIN_HZ:
            ok("%s = %d Hz (healthy; not the 1 MHz misconfig)" % (ref, rate))
        else:
            bad("%s = %d Hz (<%d Hz; 1 MHz-class misconfig breaks SPI transfers)" % (ref, rate, SPI_REF_MIN_HZ))
    rc, _ = sh("dmesg 2>/dev/null | grep -qi 'spi.*transfer timed out'")
    ok("no 'SPI transfer timed out' in dmesg") if rc != 0 \
        else bad("dmesg shows 'SPI transfer timed out' (SPI controller failing)")


def b_oled():
    _overlay()
    from rfsoc4x2.oled import oled_display
    log.debug("initialising the on-board OLED + writing text")
    d = oled_display()
    d.write("PYNQ self-test\nRFSoC4x2")
    ok("on-board OLED initialised + wrote text (verify by eye)")


def b_pmod_oled_grove():
    base = _overlay()
    from pynq.lib.pmod import Pmod_OLED, Grove_TMP, PMOD_GROVE_G4
    log.debug("loading pmod_oled.bin on PMODB + writing text")
    _free_iop(base.PMODB)
    oled = Pmod_OLED(base.PMODB)
    oled.clear()
    oled.write("RFSoC4x2 test")
    ok("Pmod OLED on PMODB loaded + wrote (verify display by eye)")
    log.debug("reading Grove temperature on PMODA G4")
    _free_iop(base.PMODA)
    tmp = Grove_TMP(base.PMODA, PMOD_GROVE_G4)
    t = tmp.read()
    ok("Grove temperature %.2f C on PMODA G4 (in range)" % t) if 0 < t < 60 \
        else bad("Grove temperature %.2f C out of the expected 0-60 C range" % t)


def b_pmod_microblaze():
    base = _overlay()
    from pynq.lib import MicroblazeLibrary
    log.debug("compiling + booting a MicroBlaze program on the PMODB IOP")
    _free_iop(base.PMODB)
    lib = MicroblazeLibrary(base.PMODB, ["gpio"])
    ran = hasattr(lib, "gpio_open")
    del lib
    ok("PMODB MicroBlaze IOP compiled + ran a program (gpio library)") if ran \
        else bad("MicroblazeLibrary loaded but the gpio API is missing")


def b_usb3():
    roots, devices = [], []
    for p in glob.glob("/sys/bus/usb/devices/*/speed"):
        try:
            with open(p) as f:
                spd = f.read().strip()
        except OSError:
            continue
        if spd in ("5000", "10000"):
            name = os.path.basename(os.path.dirname(p))
            (roots if name.startswith("usb") else devices).append(name)
    if not roots:
        raise Skip("no SuperSpeed root hub -- USB3 PHY/controller did not come up")
    log.debug("SuperSpeed root hubs=%s devices=%s", sorted(roots), sorted(devices))
    if devices:
        ok("USB3 up: SuperSpeed root hub present + %d SuperSpeed device(s) linked at >=5 Gbps"
           % len(devices))
    else:
        ok("USB3 up: SuperSpeed root hub present (plug a USB3 device into a USB-A port to link-test)")


def b_webcam():
    if not os.path.exists("/dev/video0"):
        raise Skip("/dev/video0 absent -- plug in a USB webcam")
    out = "/tmp/pynq-selftest-webcam.jpg"
    log.debug("capturing a frame with fswebcam")
    subprocess.run(["fswebcam", "--no-banner", "-d", "/dev/video0", "-r", "640x480", "--save", out],
                   check=True, capture_output=True, timeout=25)
    size = os.path.getsize(out) if os.path.exists(out) else 0
    ok("USB webcam captured a frame (%d bytes)" % size) if size > 0 else bad("USB webcam produced an empty frame")


PYNQ_VENV = "/usr/local/share/pynq-venv"


def preflight():
    errs = []
    if PYNQ_VENV not in sys.executable and PYNQ_VENV not in sys.prefix:
        errs.append("not in the PYNQ venv -- source %s/bin/activate "
                    "(or /etc/profile.d/pynq_venv.sh)" % PYNQ_VENV)
    if not os.environ.get("XILINX_XRT"):
        errs.append("XRT environment not sourced -- source /etc/profile.d/xrt_setup.sh "
                    "(plain `sudo` scrubs it; become root first, then source)")
    if errs:
        print("PRE-FLIGHT FAILED -- fix the environment and re-run:")
        for e in errs:
            print("  - %s" % e)
        sys.exit(2)


