def c_mac():
    # A random/fallback MAC has the locally-administered bit (0x02) set in the
    # first octet; a real factory MAC (read from the board EEPROM by u-boot) has
    # it clear. Catches boards that fell back to a random MAC at boot.
    iface, mac = "eth0", read("/sys/class/net/eth0/address").strip()
    if not mac:
        for name in sorted(os.listdir("/sys/class/net")):
            if name == "lo" or name.startswith(("usb", "docker", "veth", "sit")):
                continue
            mac = read("/sys/class/net/%s/address" % name).strip()
            if mac:
                iface = name
                break
    if not mac:
        raise Skip("no ethernet interface with a MAC found")
    first = int(mac.split(":")[0], 16)
    if first & 0x01:
        bad("%s MAC %s is multicast (invalid unicast address)" % (iface, mac))
    elif first & 0x02:
        bad("%s MAC %s is locally-administered (random/fallback, not read from EEPROM)" % (iface, mac))
    else:
        ok("%s MAC %s is globally-administered (factory MAC from EEPROM)" % (iface, mac))


