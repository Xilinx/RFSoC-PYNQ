# EMIO GPIO controller (PS bank at 0xff0a0000) that carries the LMK reset and
# clock-select lines. Resolve its sysfs base at runtime instead of hardcoding a
# gpiochip number, which shifts between kernels/device trees.
EMIO_GPIO_ADDR = "ff0a0000.gpio"
LMK_RESET_OFF, LMK_CLK_SEL0_OFF, LMK_CLK_SEL1_OFF = 7, 8, 12


def _emio_gpio_base():
    for p in glob.glob("/sys/class/gpio/gpiochip*"):
        if EMIO_GPIO_ADDR in os.path.realpath(p):
            return int(os.path.basename(p)[len("gpiochip"):])
    raise Skip("EMIO gpiochip (%s) not present under /sys/class/gpio" % EMIO_GPIO_ADDR)


def b_lmk_gpio():
    from pynq import GPIO
    base = _emio_gpio_base()
    log.debug("resolved EMIO gpiochip base=%d from %s realpath", base, EMIO_GPIO_ADDR)
    nums = [base + LMK_RESET_OFF, base + LMK_CLK_SEL0_OFF, base + LMK_CLK_SEL1_OFF]
    handles = []
    try:
        for n in nums:
            handles.append(GPIO(n, "out"))
        ok("LMK control GPIOs addressable via dynamic gpiochip base %d "
           "(reset=+%d, clk_sel0=+%d, clk_sel1=+%d)"
           % (base, LMK_RESET_OFF, LMK_CLK_SEL0_OFF, LMK_CLK_SEL1_OFF))
    finally:
        del handles
        for n in nums:
            try:
                with open("/sys/class/gpio/unexport", "w") as f:
                    f.write(str(n))
            except OSError:
                pass


