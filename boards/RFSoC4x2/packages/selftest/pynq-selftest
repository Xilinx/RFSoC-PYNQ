def c_overlay_download():
    py = sys.executable
    rc, _ = sh("'%s' -m pip install --no-input '%s' >/tmp/ovl-pip.log 2>&1" % (py, OVERLAY_PIP), timeout=240)
    if rc != 0:
        bad("pip install %s failed (no internet? see /tmp/ovl-pip.log)" % OVERLAY_MODULE)
        return
    ok("pip installed %s" % OVERLAY_MODULE)
    # install refuses if already present; uninstall first to stay idempotent
    sh("'%s' -m %s uninstall >/tmp/ovl-uninstall.log 2>&1 || true" % (py, OVERLAY_MODULE), timeout=60)
    rc, _ = sh("'%s' -m %s install >/tmp/ovl-get.log 2>&1" % (py, OVERLAY_MODULE), timeout=180)
    ok("%s install delivered overlay + notebooks" % OVERLAY_MODULE) if rc == 0 \
        else bad("%s install step failed (see /tmp/ovl-get.log)" % OVERLAY_MODULE)
    _, moddir = sh("'%s' -c 'import os,%s as m; print(os.path.dirname(m.__file__))'" % (py, OVERLAY_MODULE))
    _, bit = sh("find '%s' -name '*.bit' 2>/dev/null | head -1" % moddir)
    if bit:
        rc, _ = sh("'%s' -c \"from pynq import Overlay; Overlay('%s')\" >/tmp/ovl-load.log 2>&1" % (py, bit), timeout=120)
        ok("downloaded overlay programmed the PL (%s)" % os.path.basename(bit)) if rc == 0 \
            else bad("could not load a downloaded overlay bitstream (see /tmp/ovl-load.log)")
    else:
        bad("no bitstream found in the downloaded overlay")


