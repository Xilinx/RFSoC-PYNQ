def b_power_rails():
    from pynq import get_rails
    rails = get_rails()
    if not rails:
        raise Skip("get_rails() returned no PMBus rails")
    checked = fails = 0
    for name, (lo, hi) in RAIL_RANGES.items():
        if name not in rails:
            log.debug("rail %s not present in get_rails(), skipping", name)
            continue
        v = rails[name].voltage.value
        checked += 1
        within = lo <= v <= hi
        log.debug("rail %s = %.3f V (expect %.3f..%.3f) %s",
                  name, v, lo, hi, "OK" if within else "OUT-OF-RANGE")
        if not within:
            fails += 1
    if checked == 0:
        raise Skip("none of the known RFSoC4x2 rails found in get_rails()")
    ok("%d/%d PMBus rails within nominal voltage" % (checked - fails, checked)) if fails == 0 \
        else bad("%d/%d PMBus rails out of nominal voltage range (see log)" % (fails, checked))


