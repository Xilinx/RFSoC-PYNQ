# Generate the ZCU216 machine from a PS-only XSA; the base has soft MicroBlazes.
EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=zcu216
EDF_LINUX_MACHINE=zcu216
EDF_BOARD_DTS=zcu216-reva
BSP_XSA_PATH=bsp/bsp.xsa
# ZCU216 has 4 GB of PS DDR: 2 GB in each architectural memory bank.
EDF_DDR_HIGH_BANK_REG="0x8 0x0 0x0 0x80000000"
